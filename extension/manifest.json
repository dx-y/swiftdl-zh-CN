{
  "manifest_version": 3,
  "name": "SwiftDL 下载集成",
  "version": "0.5.1",
  "description": "把浏览器下载交给 SwiftDL，加快速度并支持断点续传，同时在视频上添加下载按钮。",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "yt.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "SwiftDL",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "64": "icons/64.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  }
}
